var[] nums;

nums.push(5);
nums.push(3);
nums.push(9);
nums.push(1);
nums.push(7);

print(len(nums));         // 5
print(nums.accumulate()); // 5+3+9+1+7 = 25

nums.sort();
print(nums[0]); // 1
print(nums[1]); // 3
print(nums[2]); // 5
print(nums[3]); // 7
print(nums[4]); // 9

nums.reverse();
print(nums[0]); // 9
print(nums[4]); // 1

print(nums.contains(5));   // 1
print(nums.contains(100)); // 0
print(nums.indexOf(1));    // 4 
print(nums.indexOf(999));  // -1

var last = nums.pop();
print(last);       // 1
print(len(nums));  // 4
//=========================================
Struct Example{
    var Distance;
    Example(var pos1, var pos2){
        var deltaX = pos1[0]*pos1[0] - 2*pos1[0]*pos2[0] + pos2[0]*pos2[0];
        var deltaY = pos1[1]*pos1[1] - 2*pos1[1]*pos2[1] + pos2[1]*pos2[1];
        Distance = sqroot(deltaX + deltaY);
    }
}
var[] points;
var[] A1 = {0,3};
var[] B1 = {4,0};
var[] A2 = {0, 7};
var[] B2 = {7*sqrt(3),0};
points.push(Example(A1,B1));
points.push(Example(A2,B2));
print(points[0].Distance);
print(points[1].Distance);

var[] AREF = A1.ref();
var[] ACLONE = A1.clone();
var[] ACLONEalias = A1;
A1[0] = 10;
print(ACLONE[0]);
print(AREF[0]);
print(ACLONEalias[0]);
ACLONEalias.delete(0);
print(ACLONEalias[0]);
