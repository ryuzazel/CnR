{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",

  "name": "CnR",

  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#structs"
    },
    {
      "include": "#function-declarations"
    },
    {
      "include": "#http-client"
    },
    {
      "include": "#server"
    },
    {
      "include": "#routes"
    },
    {
      "include": "#request-response"
    },
    {
      "include": "#database"
    },
    {
      "include": "#nodes-workflow"
    },
    {
      "include": "#error-handling"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#parallel"
    },
    {
      "include": "#threads"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#variables"
    }
  ],


  "repository": {

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cnr",
          "match": "\\b(var|if|else|while|for|return|function)\\b"
        }
      ]
    },


    "types": {
      "patterns": [
        {
          "name": "storage.type.cnr",
          "match": "\\b(string|char)\\b"
        }
      ]
    },


    "structs": {
      "patterns": [
        {
          "name": "keyword.type.cnr",
          "match": "\\bStruct\\b"
        },
        {
          "name": "entity.name.type.cnr",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },


    "function-declarations": {
      "patterns": [
        {
          "name": "entity.name.function.cnr",
          "match": "(?<=function\\s)[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },


    "http-client": {
      "comment": "Http.GET/POST/PUT/PATCH/DELETE(url) { header {...} body {...} }",
      "patterns": [
        {
          "match": "\\b(Http)\\s*(\\.)\\s*(GET|POST|PUT|PATCH|DELETE)\\b",
          "captures": {
            "1": { "name": "support.class.http.cnr" },
            "2": { "name": "keyword.operator.cnr" },
            "3": { "name": "support.function.http-method.cnr" }
          }
        },
        {
          "name": "keyword.other.http-block.cnr",
          "match": "\\b(header|body)\\b(?=\\s*\\{)"
        }
      ]
    },


    "server": {
      "comment": "var server = Server() { host = ...; port = ...; };",
      "patterns": [
        {
          "name": "support.class.server.cnr",
          "match": "\\bServer\\b(?=\\s*\\()"
        },
        {
          "name": "variable.parameter.server-config.cnr",
          "match": "\\b(host|port|https|certificate|privateKey|threads|backlog|keepAlive|maxBodySize|readTimeout|writeTimeout|cors|serverName|logRequests)\\b(?=\\s*=)"
        }
      ]
    },


    "routes": {
      "comment": "server.GET(\"/path\") { ... }; and server.start();",
      "patterns": [
        {
          "match": "(\\.)\\s*(GET|POST|PUT|PATCH|DELETE)\\b(?=\\s*\\()",
          "captures": {
            "1": { "name": "keyword.operator.cnr" },
            "2": { "name": "support.function.http-method.cnr" }
          }
        },
        {
          "name": "support.function.server-lifecycle.cnr",
          "match": "(?<=\\.)\\bstart\\b(?=\\s*\\()"
        }
      ]
    },


    "request-response": {
      "comment": "request.method/path/ip/params/query/header/cookie/body/json and response.status/header()/cookie()/redirect()",
      "patterns": [
        {
          "match": "\\b(request)\\b\\s*(\\.)\\s*(method|path|ip|params|query|header|cookie|body|json|contentType|contentLength)\\b",
          "captures": {
            "1": { "name": "variable.language.request.cnr" },
            "2": { "name": "keyword.operator.cnr" },
            "3": { "name": "variable.other.property.cnr" }
          }
        },
        {
          "match": "\\b(response)\\b\\s*(\\.)\\s*(status)\\b",
          "captures": {
            "1": { "name": "variable.language.response.cnr" },
            "2": { "name": "keyword.operator.cnr" },
            "3": { "name": "variable.other.property.cnr" }
          }
        },
        {
          "match": "\\b(response)\\b\\s*(\\.)\\s*(header|cookie|redirect)\\b(?=\\s*\\()",
          "captures": {
            "1": { "name": "variable.language.response.cnr" },
            "2": { "name": "keyword.operator.cnr" },
            "3": { "name": "support.function.response-method.cnr" }
          }
        }
      ]
    },


    "database": {
      "comment": "Data Name(\"file\"){ Struct ...; table Struct varName [primaryKey field]; } and Data1.table.push()/find()/findWhere()/findById()/get()/getById()/insert()/updateWhere()/updateById()/delete()/deleteWhere()/deleteById()/orderBy()/save()/load()/count()/encode()",
      "patterns": [
        {
          "name": "support.class.database.cnr",
          "match": "\\bData\\b(?=\\s+[A-Za-z_])"
        },
        {
          "name": "keyword.control.table.cnr",
          "match": "\\btable\\b"
        },
        {
          "name": "keyword.other.primarykey.cnr",
          "match": "\\bprimaryKey\\b"
        },
        {
          "match": "(\\.)\\s*(encode|findWhere|findById|getById|get|find|updateWhere|updateById|deleteWhere|deleteById|delete|insert|orderBy|push|save|load|count)\\b(?=\\s*\\()",
          "captures": {
            "1": { "name": "keyword.operator.cnr" },
            "2": { "name": "support.function.database-method.cnr" }
          }
        }
      ]
    },


    "nodes-workflow": {
      "comment": "Nodes Name { NodeName(dep1, dep2) -> OnFail(Retry = N) { ... Fail(); ... } }",
      "patterns": [
        {
          "name": "keyword.control.nodes.cnr",
          "match": "\\bNodes\\b"
        },
        {
          "match": "(\\bNodes\\b)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.nodes.cnr" },
            "2": { "name": "entity.name.type.workflow.cnr" }
          }
        },
        {
          "name": "keyword.control.onfail.cnr",
          "match": "\\bOnFail\\b"
        },
        {
          "name": "variable.parameter.retry.cnr",
          "match": "\\bRetry\\b(?=\\s*=)"
        },
        {
          "name": "keyword.operator.arrow.cnr",
          "match": "->"
        },
        {
          "name": "support.function.fail.cnr",
          "match": "\\bFail\\b(?=\\s*\\()"
        },
        {
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
          "captures": {
            "1": { "name": "entity.name.function.node.cnr" },
            "2": { "name": "punctuation.section.parens.begin.cnr" }
          }
        }
      ]
    },


    "error-handling": {
      "comment": "try { ... } catch(var e) { ... } and Throw(\"message\");",
      "patterns": [
        {
          "name": "keyword.control.trycatch.cnr",
          "match": "\\b(try|catch)\\b"
        },
        {
          "name": "support.function.throw.cnr",
          "match": "\\bThrow\\b(?=\\s*\\()"
        }
      ]
    },


    "functions": {
      "patterns": [
        {
          "name": "support.function.cnr",
          "match": "\\b(print|len|push|pop|sort|reverse|accumulate|contains|indexOf)\\b"
        }
      ]
    },


    "parallel": {
      "patterns": [
        {
          "name": "keyword.control.parallel.cnr",
          "match": "\\bParallel\\b"
        }
      ]
    },


    "threads": {
      "patterns": [
        {
          "name": "support.function.thread.cnr",
          "match": "\\b(thread|join|joinAll)\\b"
        }
      ]
    },


    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.cnr",
          "match": "\\b(true|false)\\b"
        }
      ]
    },


    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.cnr",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },


    "strings": {
      "name": "string.quoted.double.cnr",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.cnr",
          "match": "\\\\."
        }
      ]
    },


    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.cnr",
          "match": "(\\+|-|\\*|/|%|==|!=|<=|>=|<|>|=|&&|\\|\\||\\.|:)"
        }
      ]
    },


    "variables": {
      "patterns": [
        {
          "name": "variable.other.cnr",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },


    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cnr",
          "match": "//.*$"
        },
        {
          "name": "comment.block.cnr",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    }

  },

  "scopeName": "source.cnr"
}