{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CnR",
  "scopeName": "source.cnr",
  "patterns": [
    {"include":"#comments"},
    {"include":"#strings"},
    {"include":"#numbers"},
    {"include":"#constants"},
    {"include":"#keywords"},
    {"include":"#types"},
    {"include":"#casts"},
    {"include":"#matrix-types"},
    {"include":"#structs"},
    {"include":"#function-declarations"},
    {"include":"#function-calls"},
    {"include":"#constructors"},
    {"include":"#functions"},
    {"include":"#http-client"},
    {"include":"#server"},
    {"include":"#routes"},
    {"include":"#request-response"},
    {"include":"#database"},
    {"include":"#nodes-workflow"},
    {"include":"#error-handling"},
    {"include":"#parallel"},
    {"include":"#threads"},
    {"include":"#operators"},
    {"include":"#variables"}
  ],
  "repository": {
    "comments":{"patterns":[
      {"name":"comment.line.double-slash.cnr","match":"//.*$"},
      {"name":"comment.block.cnr","begin":"/\\*","end":"\\*/",
       "patterns":[{"name":"keyword.other.todo.cnr","match":"\\b(TODO|FIXME|BUG|NOTE|WARNING|HACK)\\b"}]}
    ]},
    "strings":{"name":"string.quoted.double.cnr","begin":"\"","end":"\"","patterns":[{"name":"constant.character.escape.cnr","match":"\\\\(?:[nrt\"\\\\]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4})"}]},
    "numbers":{"patterns":[{"name":"constant.numeric.cnr","match":"\\b(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|0[oO][0-7_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?)\\b"}]},
    "constants":{"patterns":[{"name":"constant.language.cnr","match":"\\b(pi|e|euler|phi|psi|null|true|false)\\b"}]},
    "keywords":{"patterns":[{"name":"keyword.control.cnr","match":"\\b(var|if|else|while|for|return|function|break|continue|switch|case|default|do|try|catch|Struct|Parallel|Nodes|Data|Throw|import|using|namespace)\\b"}]},
    "types":{"patterns":[{"name":"storage.type.cnr","match":"\\b(var|void|bool|char|string|Int|long|Float|double|BigInt|BigFloat|bigDouble)\\b"}]},
    "casts":{"patterns":[{"name":"storage.type.cast.cnr","match":"(?<=\\()(Int|long|Float|double|BigInt|BigFloat|bigDouble|string|char|bool)(?=\\))"}]},
    "matrix-types":{"patterns":[{"name":"storage.type.matrix.cnr","match":"\\bvar(?:\\s*\\[\\])+"}]},
    "structs":{"patterns":[{"name":"entity.name.type.cnr","match":"\\b[A-Z][A-Za-z0-9_]*\\b"}]},
    "function-declarations":{"patterns":[{"name":"entity.name.function.cnr","match":"(?<=function\\s)[A-Za-z_][A-Za-z0-9_]*"}]},
    "function-calls":{"patterns":[{"name":"entity.name.function.call.cnr","match":"\\b[A-Za-z_][A-Za-z0-9_]*(?=\\()"}]},
    "constructors":{"patterns":[{"name":"support.class.constructor.cnr","match":"\\b(Server|Data|Matrix|Tensor|BigFloat|BigInt)(?=\\()"}]},
    "functions":{"patterns":[{"name":"support.function.cnr","match":"\\b(print|len|push|pop|sort|reverse|accumulate|contains|indexOf|sqrt|sqroot|pow|exp|log|log10|sin|cos|tan|asin|acos|atan|abs|floor|ceil|round|min|max|random|randomSeed)\\b"}]},
    "http-client":{"patterns":[{"name":"support.class.http.cnr","match":"\\bHttp\\b"}]},
    "server":{"patterns":[{"name":"support.class.server.cnr","match":"\\bServer(?=\\()"}]},
    "routes":{"patterns":[{"name":"support.function.http-method.cnr","match":"(?<=\\.)\\b(GET|POST|PUT|PATCH|DELETE|start)\\b"}]},
    "request-response":{"patterns":[{"name":"variable.other.property.cnr","match":"(?<=\\.)[A-Za-z_][A-Za-z0-9_]*"}]},
    "database":{"patterns":[{"name":"support.function.database-method.cnr","match":"(?<=\\.)\\b(find|findWhere|findById|get|getById|insert|updateWhere|updateById|delete|deleteWhere|deleteById|push|save|load|count|orderBy|encode)\\b"}]},
    "nodes-workflow":{"patterns":[{"name":"keyword.control.nodes.cnr","match":"\\b(Nodes|OnFail|Retry|Fail)\\b"}]},
    "error-handling":{"patterns":[{"name":"support.function.throw.cnr","match":"\\bThrow(?=\\()"}]},
    "parallel":{"patterns":[{"name":"keyword.control.parallel.cnr","match":"\\bParallel\\b"}]},
    "threads":{"patterns":[{"name":"support.function.thread.cnr","match":"\\b(thread|join|joinAll)\\b"}]},
    "operators":{"patterns":[{"name":"keyword.operator.cnr","match":"(\\+\\+|--|\\+=|-=|\\*=|/=|%=|==|!=|<=|>=|&&|\\|\\||<<|>>|->|::|\\?|\\+|-|\\*|/|%|=|<|>|!|\\.|:|&|\\|)"}]},
    "variables":{"patterns":[
      {"name":"variable.other.definition.cnr","match":"(?<=\\bvar\\s)[A-Za-z_][A-Za-z0-9_]*"},
      {"name":"variable.other.cnr","match":"\\b[A-Za-z_][A-Za-z0-9_]*\\b"}
    ]}
  }
}
