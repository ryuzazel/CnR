{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",

  "name": "CnR",

  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#structs"
    },
    {
      "include": "#function-declarations"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#parallel"
    },
    {
      "include": "#threads"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#variables"
    }
  ],


  "repository": {

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cnr",
          "match": "\\b(var|if|else|while|for|return|break|continue|function)\\b"
        }
      ]
    },


    "types": {
      "patterns": [
        {
          "name": "storage.type.cnr",
          "match": "\\b(string|int|double|bool)\\b"
        }
      ]
    },


    "structs": {
      "patterns": [
        {
          "name": "keyword.type.cnr",
          "match": "\\bStruct\\b"
        },
        {
          "name": "entity.name.type.cnr",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },


    "function-declarations": {
      "patterns": [
        {
          "name": "entity.name.function.cnr",
          "match": "(?<=function\\s)[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },


    "functions": {
      "patterns": [
        {
          "name": "support.function.cnr",
          "match": "\\b(print|len|push|pop|push_back|pop_back|sort|reverse|accumulate|contains|indexOf|train|predict|roots|integral|derivative)\\b"
        }
      ]
    },


    "parallel": {
      "patterns": [
        {
          "name": "keyword.control.parallel.cnr",
          "match": "\\bParallel\\b"
        }
      ]
    },


    "threads": {
      "patterns": [
        {
          "name": "support.function.thread.cnr",
          "match": "\\b(thread|join|joinAll|await)\\b"
        }
      ]
    },


    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.cnr",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },


    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.cnr",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },


    "strings": {
      "name": "string.quoted.double.cnr",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.cnr",
          "match": "\\\\."
        }
      ]
    },


    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.cnr",
          "match": "(\\+|-|\\*|/|%|==|!=|<=|>=|<|>|=|&&|\\|\\||\\.)"
        }
      ]
    },


    "variables": {
      "patterns": [
        {
          "name": "variable.other.cnr",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },


    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cnr",
          "match": "//.*$"
        },
        {
          "name": "comment.block.cnr",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    }

  },

  "scopeName": "source.cnr"
}